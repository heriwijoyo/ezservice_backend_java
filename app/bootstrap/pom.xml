<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>ezclouds-parent</artifactId>
        <groupId>id.ezclouds</groupId>
        <version>1.0.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <groupId>id.ezclouds.app</groupId>
    <artifactId>ezclouds-app-bootstrap</artifactId>
    <version>1.0.0</version>

    <dependencies>
        <!-- start ez modules -->
        <dependency>
            <groupId>id.ezclouds.core</groupId>
            <artifactId>ezclouds-core-bifrost</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>id.ezclouds.biz</groupId>
            <artifactId>biz-ezservice</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>id.ezclouds.core</groupId>
            <artifactId>ezclouds-core-broker</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>id.ezclouds.common</groupId>
            <artifactId>ezclouds-common-facade</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>id.ezclouds.core</groupId>
            <artifactId>ezclouds-core-admin</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>id.ezclouds.core</groupId>
            <artifactId>ezclouds-core-auth</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>id.ezclouds.core</groupId>
            <artifactId>ezclouds-core-biz</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>id.ezclouds.core</groupId>
            <artifactId>ezclouds-core-integration</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>id.ezclouds.core</groupId>
            <artifactId>ezclouds-core-dal</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>id.ezclouds.core</groupId>
            <artifactId>ezclouds-core-member</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>id.ezclouds.core</groupId>
            <artifactId>ezclouds-core-param</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>id.ezclouds.core</groupId>
            <artifactId>ezclouds-core-process</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>id.ezclouds.core</groupId>
            <artifactId>ezclouds-core-shared</artifactId>
            <version>1.0.0</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>EzCloudsServerApp</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <outputDirectory>../../target/</outputDirectory>
                    <addResources>true</addResources>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>