            <fileNamePattern>${APP_LOG_ROOT}/${APP_NAME}/common-error.log.%d{yyyy-MM-dd}</fileNamePattern>
        </rollingPolicy>
        <append>true</append>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>error</level>
        </filter>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d --- [%thread]%m%n</pattern>
        </encoder>
    </appender>

    <appender name="API_CONTROLLER_File"
